# -----------------------------------------------------------------------------
# Contact form email delivery (all optional)
# -----------------------------------------------------------------------------
# The contact form works out of the box: it validates input, checks the
# honeypot field, and logs valid submissions to the server console (visible
# in your Vercel function logs) even if nothing below is configured.
#
# To actually receive an email when someone submits the form, connect a free
# transactional email provider. Resend has a free tier and is what the API
# route (app/api/contact/route.ts) is wired for by default:
#
#   1. Create a free account at https://resend.com
#   2. Verify a sending domain (or use their onboarding@resend.dev sender
#      while testing)
#   3. Create an API key and paste it below
#
# Never commit your real .env file — only .env.example should be in git.
# Copy this file to .env.local for local development, and add the same
# values in your Vercel Project Settings → Environment Variables for
# production.

# Your Resend API key
RESEND_API_KEY=

# The inbox that should receive contact form submissions
CONTACT_TO_EMAIL=Imranresearch.a@gmail.com

# The "from" address Resend is authorized to send as (must be on a verified
# domain, or Resend's shared onboarding@resend.dev address while testing)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------------------------------
# Site metadata (used for SEO / Open Graph absolute URLs)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-deployed-site.vercel.app
